# --- Neo4j (BYO) ---
# ThreadMap is BYO-Neo4j. Point these at your own instance.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=threadmap-dev
NEO4J_DATABASE=neo4j

# --- Server ---
PORT=4000
# Comma-separated allowed origins for the web app
CORS_ORIGIN=http://localhost:5173

# --- LLM Sidecar (optional) ---
# The sidecar is OPTIONAL and read-only. It never mutates the graph.
# Leave ANTHROPIC_API_KEY unset to run ThreadMap fully without an LLM.
ANTHROPIC_API_KEY=
# Default model for the sidecar.
THREADMAP_LLM_MODEL=claude-opus-4-8

# --- Web (Vite) ---
VITE_API_BASE=http://localhost:4000
